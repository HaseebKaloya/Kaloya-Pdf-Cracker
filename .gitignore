# Kaloya PDF Cracker — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/

# ── PyInstaller build artifacts (never commit compiled output) ────────────────
build/
dist/
*.spec.bak

# ── Runtime-generated files ───────────────────────────────────────────────────
hash.txt
result.txt

# ── John the Ripper runtime state ────────────────────────────────────────────
john/run/john.pot
john/run/john.log
john/run/*.session
john/run/john.rec

# ── Installer build output (the .exe goes to GitHub Releases, not the repo) ──
installer/Output/

# ── Old/redundant image files (replaced by correct .bmp versions) ─────────────
installer/wizard_sidebar.png
installer/wizard_header.png

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/

# ── IDE / editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Temporary / scratch files ─────────────────────────────────────────────────
*.tmp
*.bak
*.swp

# ── Local platform posting guides (private reference only) ────────────────────
POSTING_PLATFORM_GUIDE/
